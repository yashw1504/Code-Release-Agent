
{
  "name": "Secure Code Release Policy",
  "version": "1.0",
  "max_risk_score": 30,
  "block_severities": [
    "CRITICAL"
  ],
  "review_severities": [
    "HIGH"
  ],
  "unknown_severity_action": "REVIEW",
  "fail_on_missing_required_scan": true,
  "required_scanners": [
    "semgrep",
    "trivy",
    "gitleaks"
  ]
}
